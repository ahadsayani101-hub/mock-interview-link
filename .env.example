# Required for real questions and scoring (without it the app runs in demo mode)
ANTHROPIC_API_KEY=

# Email: pick ONE option
# Option A, Gmail: an app password from https://myaccount.google.com/apppasswords (needs 2-step verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B, Resend: only sends to your own address until you verify a domain
RESEND_API_KEY=
EMAIL_FROM=

# Optional short links (needed for a scannable QR code). Vercel sets these when you
# connect an Upstash Redis database from the Storage tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
