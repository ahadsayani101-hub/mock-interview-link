# Required for real questions and scoring (without it the app runs in demo mode)
ANTHROPIC_API_KEY=

# Natural interviewer voice: pick ONE (without either, the phone's built-in voice is used)
# Option A, OpenAI (recommended, about a cent per interview): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# TTS_VOICE=coral   # also try: sage, ash, ballad, verse, alloy, marin, cedar
# Option B, ElevenLabs (free tier is about 6 interviews a month): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Email: pick ONE option
# Option A, Gmail: an app password from https://myaccount.google.com/apppasswords (needs 2-step verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B, Resend: only sends to your own address until you verify a domain
RESEND_API_KEY=
EMAIL_FROM=

# Optional short links (needed for a scannable QR code). Vercel sets these when you
# connect an Upstash Redis database from the Storage tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
