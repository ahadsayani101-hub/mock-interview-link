# Required for real questions and scoring (without it the app runs in demo mode)
ANTHROPIC_API_KEY=

# Live interviewer: a real-time, hands-free voice conversation (OpenAI Realtime).
# Get a key at https://platform.openai.com/api-keys and add a few dollars of credit.
# Roughly $1-2 per 10-minute interview. Without it, interviews use tap-to-talk.
OPENAI_API_KEY=
# REALTIME_MODEL=gpt-realtime-2.1
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Tap-to-talk voice (only used when the live interviewer isn't available). OpenAI above
# covers it too; ElevenLabs is an alternative. Without either, the phone's built-in voice is used.
# TTS_VOICE=marin
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Email: pick ONE option
# Option A, Gmail: an app password from https://myaccount.google.com/apppasswords (needs 2-step verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B, Resend: only sends to your own address until you verify a domain
RESEND_API_KEY=
EMAIL_FROM=

# Optional short links (needed for a scannable QR code). Vercel sets these when you
# connect an Upstash Redis database from the Storage tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
