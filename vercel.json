{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/i", "destination": "/" },
    { "source": "/i/:id", "destination": "/" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ],
  "functions": {
    "api/create.js": { "maxDuration": 300 },
    "api/turn.js": { "maxDuration": 60 },
    "api/finish.js": { "maxDuration": 120 },
    "api/speak.js": { "maxDuration": 30 },
    "api/listen.js": { "maxDuration": 60 },
    "api/realtime.js": { "maxDuration": 15 },
    "api/plan.js": { "maxDuration": 10 }
  }
}
